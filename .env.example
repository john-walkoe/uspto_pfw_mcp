
# =============================================================================
# Required
# =============================================================================
# USPTO Open Data Portal API key. Free from https://data.uspto.gov/myodp/ -
# see API_KEY_GUIDE.md. The deploy scripts can store it in the OS secure store
# instead, in which case leave this unset.
# USPTO_API_KEY=

# =============================================================================
# OAuth sign-in (dual IdP: Google + Entra ID) — HTTP mode only
# =============================================================================
# "none" (default) keeps today's behavior. "oauth" turns the HTTP surface into
# an OAuth 2.1 authorization server: users sign in with Google/Microsoft and
# must have an active row in the mcp_users table (see
# scripts/manage_mcp_users.py and the pfw_manage_users tool). PFW hosts the
# shared mcp_users DB - point PTAB/FPD *_AUTH_DB_PATH at the same file
# (shared bind mount, same host only).
# PFW_AUTH_MODE=oauth
# PFW_AUTH_BASE_URL=https://your-public-hostname.example.com
# PFW_AUTH_JWT_SECRET=  # openssl rand -hex 32 — rotating logs everyone out
# PFW_AUTH_GOOGLE_CLIENT_ID=
# PFW_AUTH_GOOGLE_CLIENT_SECRET=
# PFW_AUTH_MS_CLIENT_ID=
# PFW_AUTH_MS_CLIENT_SECRET=
# PFW_AUTH_MS_TENANT=common  # common | organizations | tenant GUID
# PFW_AUTH_INTERNAL_TOKEN=   # openssl rand -hex 32 — static bearer for headless clients
#                            # (pfw:user ONLY — existing internal-gateway
#                            # tokens keep working for the data tools but no
#                            # longer grant pfw:admin; this is intended)
# PFW_AUTH_INTERNAL_ADMIN_TOKEN=  # openssl rand -hex 32 — SEPARATE static
#                            # bearer granting pfw:user + pfw:admin. Issue
#                            # this only to whichever internal caller
#                            # actually needs to manage users; most
#                            # deployments should leave it unset.
# PFW_AUTH_ALLOWED_REDIRECT_HOSTS=   # comma-separated EXTRA hosts allowed to
#                            # dynamically register a redirect_uri. claude.ai,
#                            # claude.com, anthropic.com, chatgpt.com, openai.com,
#                            # localhost and 127.0.0.1 are always allowed
#                            # (subdomains included). Clients already registered
#                            # are unaffected.
# PFW_AUTH_OPEN_REGISTRATION=false   # true restores fully open Dynamic Client
#                            # Registration. Leave false: an arbitrary redirect_uri
#                            # is the first half of an identity-takeover chain.
# PFW_AUTH_REGISTER_URL=     # optional "Request access" link
# PFW_AUTH_ACCESS_TTL=3600
# PFW_AUTH_REFRESH_TTL=2592000
# PFW_AUTH_DB_PATH=data/mcp_auth.db

# Hardened data directory (0700) for encryption keys and proxy SQLite files.
# Default ~/.uspto_pfw_mcp/data; legacy project-root files migrate on start.
# PFW_DATA_DIR=/path/to/data

# Reverse-proxy peers whose X-Forwarded-For header is trusted for client-IP
# attribution (rate limiting, security audit log). Comma-separated IPs or
# CIDRs. Default 127.0.0.1.
#
# Name the peers. "*" trusts the header from ANY source, which makes every
# logged client IP forgeable: an attacker sets their own X-Forwarded-For, and
# the rate-limit bucket and the security audit log both attribute to whatever
# they chose. That is a hole in two controls at once, so it is documented here
# as the thing NOT to do rather than as an option (audit L-18).
# PROXY_TRUSTED_IPS=127.0.0.1

# Register the pfw_manage_users admin tool. Default false: stdio never needs
# it (use scripts/manage_mcp_users.py), and outside OAuth mode it would be
# protected only by the shared INTERNAL_AUTH_SECRET. Set true on OAuth
# deployments that want the in-chat user-management panel.
# PFW_ENABLE_USER_MANAGEMENT=true

# Register the MCP prompt templates (patent_search, document_filtering_assistant,
# etc.). Default false: no prompts appear in prompts/list unless this is set.
# Set true on deployments that want the prompt templates exposed to clients.
# PFW_ENABLE_PROMPTS=true

# =============================================================================
# Shared USPTO rate limiting (off by default)
# =============================================================================
# All 4 USPTO MCPs (citations/pfw/ptab/fpd) can run as containers sharing one
# host/netns under a SINGLE USPTO API key. USPTO's documented limits are
# per-KEY (burst=1, no parallel requests; 4-15 req/sec by call type; weekly
# quotas), so a per-process limiter can't see what the other 3 processes are
# doing. Setting USPTO_SHARED_RATE_LIMIT_DIR points all of them at one
# bind-mounted directory; a cross-process token bucket + a bounded pool of
# concurrency slots, both arbitrated via POSIX file locks (flock — released
# automatically by the kernel on process death, so it's crash-safe), keep
# the combined request rate under the shared key's limits. Leave unset for a
# standalone deployment.
# USPTO_SHARED_RATE_LIMIT_DIR=/var/run/uspto-shared-rate-limit
# USPTO_SHARED_RATE_LIMIT_RPS=4.0       # total tokens/sec across ALL 4 MCPs
# USPTO_SHARED_MAX_CONCURRENT=2         # shared in-flight request slots
#
# Shared-limiter wait ceiling: how long a call waits for a cross-process token
# or concurrency slot before failing (default 30s). flock is kernel-released on
# process death, but a process that HANGS while holding a slot would otherwise
# stall every later tool call until the MCP client's own timeout.
# USPTO_SHARED_MAX_WAIT_SECONDS=30

# =============================================================================
# Response-size guard (shared/response_bounds.py)
# =============================================================================
# claude.ai replaces an OVERSIZED tool result with a client-side truncation
# error the server never sees: the model gets no data and no way to recover.
# The cap applies to the serialized payload, so these budgets are CHARACTER
# budgets (len(json.dumps(...))), never token estimates. Shared, identically
# named, across the FPD/PTAB/PFW MCPs.
#
# Structured responses (searches, document lists, family graphs) are slimmed
# then truncated to fit, always with a `_bounds` marker carrying recovery
# guidance. Document and office-action content gets the higher content budget
# and a `_window` cursor instead - nothing is lost, it is paged via
# char_offset/max_chars. PFW_get_guidance('limits') prints the LIVE values.
# USPTO_MAX_RESPONSE_CHARS=40000
# USPTO_MAX_CONTENT_CHARS=120000
# USPTO_RESPONSE_BOUNDS_ENABLED=true    # false disables the guard entirely

# Per-document page cap for the pypdf native-text-layer tier (was unbounded -
# it walked every page of the document). Same variable name in the PTAB MCP.
# A capped extraction is always marked (truncated / truncation_note /
# _bounds with reason "window").
# PYPDF_MAX_PAGES=200

# Per-document page cap for the Mistral OCR tier. Same variable name in
# the FPD and PTAB MCPs. A capped extraction is always marked.
# MISTRAL_OCR_MAX_PAGES=50

# Cumulative DAILY page ceiling for the Mistral OCR tier. The per-minute call
# limit caps the burst rate but not the total: 10 calls/minute at 50 pages
# each is 720,000 pages a day. Pages are the unit the OCR service works in, so
# the ceiling is in pages. Checked before anything is uploaded, so a refusal
# never sends the document anywhere. 0 or below disables it.
# MISTRAL_OCR_DAILY_PAGE_BUDGET=2000

# Seconds of OCR timeout allowed PER PAGE. One flat 30s allowance used to
# cover both the multipart upload and the OCR of up to MISTRAL_OCR_MAX_PAGES
# pages; a 50-page OCR does not reliably finish in 30s, and when it timed out
# the work had already been done upstream and the result was thrown away. The
# effective timeout is max(MISTRAL_OCR_TIMEOUT, this * pages).
# MISTRAL_OCR_SECONDS_PER_PAGE=6

# Ceiling on a single document buffered for text extraction. The extraction
# path holds the PDF in memory up to three times over (raw bytes, the page
# slice, the OCR multipart body). Over this, the tool refuses and tells the
# caller to request a page window. The download PROXY streams and is unaffected.
# PFW_MAX_DOCUMENT_BYTES=100000000

# The gate between the pypdf native-text-layer tier and the OCR tiers: how
# much usable text a PDF's own text layer must yield before the document is
# treated as a scan. A threshold slightly too strict silently sends
# already-readable documents through OCR, so these are tunable and the
# escalation log line names which one fired.
# PFW_EXTRACT_MIN_CHARS=50
# PFW_EXTRACT_MIN_WORDS=10
# PFW_EXTRACT_MAX_AVG_WORD_LEN=20
# PFW_EXTRACT_MIN_ALPHA_RATIO=0.6

# =============================================================================
# Persistent download links
# =============================================================================
# A /document/persistent/{hash} link is a TOKENLESS bearer capability: the
# hash IS the credential, and it reaches chat transcripts, support tickets and
# screenshots. Bounded on two axes rather than one.
#
# Link lifetime in days. Was 7; 1 by default now.
# PFW_LINK_TTL_DAYS=1
#
# How many times one link may be resolved before it is dropped. 0 disables the
# ceiling (the old behavior: unlimited use for the whole TTL).
# PFW_LINK_MAX_USES=25
#
# A leaked hash can also be revoked immediately:
#   curl -X DELETE -H "X-Proxy-Token: $PROXY_TOKEN" \
#        http://127.0.0.1:8080/document/persistent/<hash>

# =============================================================================
# Download-proxy and transport secrets
# =============================================================================
# Shared secret for the X-Proxy-Token gate on the proxy's admin, stats and
# /download/* routes. REQUIRED when the proxy runs as a separate process
# (ENABLE_ALWAYS_ON_PROXY=true on the HTTP transport): an auto-generated token
# differs per process, so the tool's download registration would 401 silently
# and Recent Downloads would stop updating. Minimum 16 characters.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# PROXY_TOKEN=

# Shared secret for inter-MCP tokens (FPD/PTAB registering documents with this
# proxy) AND for the x-api-key transport gate. The server REFUSES to start on
# the HTTP transport without it. Same value across the MCPs that talk to each
# other. Never generated at runtime.
#   python -c "import secrets; print(secrets.token_hex(32))"
# May be a comma-separated list, CURRENT value first: "new,old" gives a
# rotation overlap window instead of requiring a synchronized four-service
# restart (both the x-api-key gate and the inter-MCP service-token verifier
# accept any listed value). See "Rolling rotation" below and
# scripts/rotate_internal_auth_secret.py.
# INTERNAL_AUTH_SECRET=

# Bind address for the download proxy. Default 127.0.0.1 (localhost only).
# Set 0.0.0.0 in Docker so the host browser can reach the exposed port.
# PROXY_BIND_HOST=127.0.0.1

# Comma-separated IPs/CIDRs allowed to reach the proxy. Default is loopback.
# PROXY_ALLOWED_IPS=127.0.0.1

# One additional CORS origin for the MCP HTTP transport beyond localhost,
# comma-separated. Format-validated at startup; a malformed value fails fast.
# CORS_EXTRA_ORIGIN=https://example.com

# =============================================================================
# Document text extraction
# =============================================================================
# Extraction walks capability tiers, not price tiers: the USPTO's own
# free-text variants, then the PDF's native text layer (pypdf), then OCR for
# pages that carry no usable text layer. The OCR step needs a backend, and
# there are two. Configure either, both, or neither.
#
# Mistral OCR credential. OPTIONAL: without it the text-layer tiers still run,
# a configured Docling backend still serves scans, and the tool reports what it
# could not extract rather than failing silently. Placeholder values
# ("your_key_here", "change_me", "test_key", ...) are detected and treated as
# unset, so a copy-pasted config produces guidance, not an auth error.
# MISTRAL_API_KEY=

# Self-hosted OCR backend (Docling, e.g. docling-serve). Needs no third-party
# credential and keeps document bytes on infrastructure you control. When
# MISTRAL_API_KEY is set, Docling is the tier after Mistral; with no Mistral
# key configured, Docling IS the OCR tier.
#
# Base URL of the docling-serve instance. Unset, the Docling tier is skipped.
# DOCLING_SERVE_URL=http://localhost:5001
# DOCLING_SERVE_URL=https://your-docling-host.example.com
#
# Read timeout in seconds for OCR processing. EasyOCR runs roughly 10-30
# seconds per page on CPU, so a long scan needs headroom; raise it for very
# large documents (e.g. DOCLING_TIMEOUT=600).
# DOCLING_TIMEOUT=300
#
# Skip Docling for documents longer than this page count. A 60-page scan at
# CPU speeds would outlast the MCP client's own tool-call timeout, so it is
# refused with advice to ask for a page window instead.
# DOCLING_MAX_PAGES=25

# =============================================================================
# Encryption-key provenance and secret rotation
# =============================================================================
# The Fernet keys protecting the link cache and the FPD/PTAB stores come from
# the OS secure store (DPAPI / systemd-creds) when one is available. In a
# container it usually is NOT, and the fallback is a 0600 key file — by
# default in the SAME directory as the ciphertext it protects, so one volume
# copy or one backup job carries both halves.
#
# Either of these fixes that. The proxy's `/` health payload reports which
# backend actually served each key, so it can be verified rather than assumed.
#
# 1. Supply the key from a container secret (base64 of a Fernet key):
# PFW_PROXY_ENCRYPTION_KEY=
# PFW_FPD_DOCSTORE_KEY=
# PFW_PTAB_DOCSTORE_KEY=
#
# 2. Or keep the file fallback but put it on a different volume:
# PFW_KEY_DIR=/run/secrets/pfw-keys

# Rolling rotation for the inter-MCP shared secret (S-06, PT-14):
#   uv run python scripts/rotate_internal_auth_secret.py
# generates a new root and prints the two-step env line to use. Two ways to
# express the overlap window, both accepted everywhere this secret is
# checked (x-api-key gate, inter-MCP service tokens):
#   1. INTERNAL_AUTH_SECRET=new-value,old-value   (preferred; one var)
#   2. INTERNAL_AUTH_SECRET=new-value + INTERNAL_AUTH_SECRET_PREVIOUS=old-value
# Tokens are always SIGNED with the CURRENT (first-listed) secret; every
# other listed one is accepted for VERIFICATION only, and only via the same
# checks the current secret would pass. Deploy the combined value, roll each
# of the four MCPs one at a time, then drop the old value and roll again to
# close the window. Without an overlap window, rotating meant restarting all
# four servers in the same instant or inter-MCP registration failed.
# INTERNAL_AUTH_SECRET_PREVIOUS=

# =============================================================================
# Security alert delivery
# =============================================================================
# Threshold alerts are tuned and fire correctly, but by default the only
# effect is another line in the security log. Configure a transport so a
# detection has somewhere to go. Both are off by default; failures are
# best-effort and never fail the request that produced the alert.
# PFW_ALERT_LOG_PATH=/var/log/pfw/alerts.log      # separate file, not buried
# PFW_ALERT_WEBHOOK_URL=                          # Slack-compatible JSON POST
# PFW_ALERT_WEBHOOK_TIMEOUT=5
